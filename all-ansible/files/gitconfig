[push]
default = current
followTags = true

[status]

[merge]
ff = false
	conflictStyle = diff3

[diff]
renames = copy
algorithm = histogram

[log]
date = relative
decorate = short

[pretty]
line = %C(yellow)%h %Cblue%ad %Cgreen%aN%Creset %s

[interactive]
singlekey = true
diffFilter = delta --color-only --features=interactive

[color]
ui = auto
status = auto
branch = auto
interactive = auto
diff = auto

[alias]
s = status
ci = commit
co = checkout
a = add -Av
tip = log -n1
di = diff HEAD
du = diff @{u}...
lu = log @{u}.. --reverse
ds = diff --staged
ru = !git reset --hard origin/$(git branch --show-current)
pu = -c 'merge.ff=true' pull --prune
unstage = reset HEAD --
temp = commit -m 'temp' --no-verify
untemp = reset HEAD^
g = grep -n
not = log HEAD --not
new = log @{u} --not HEAD --reverse
serve = !git daemon --reuseaddr --verbose  --base-path=. --export-all ./.git
amend = commit --amend --no-edit
force = -c 'push.default=current' push --force-with-lease
circleci = !git a && git amend && git force

[user]
name = Glen Mailer
email = glen@geckoboard.com

[github]
user = glenjamin

[core]
excludesfile = ~/.gitignore_global
	trustctime = false
pager=delta
	editor = vim
[rebase]
autosquash = true
[rerere]
enabled = true
[cola]
spellcheck = false
[url "https://github.com/"]
	insteadOf = git@github.com:
[pull]
	ff = only
[init]
    defaultBranch = main

[delta]
    features = decorations

[delta "interactive"]
    keep-plus-minus-markers = false

[delta "decorations"]
    commit-decoration-style = blue ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
