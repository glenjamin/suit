{
  "// permissions": "defaultMode 'auto' runs a background classifier on every action. The lists below are the curated exceptions to that flow.",
  "permissions": {
    "// allow": "Hard-allowed: bypasses the auto-mode classifier entirely (no prompt, no check). Safe read-only / idempotent commands only.",
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm test:*)",
      "Bash(npm t:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(make vendor)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr-feedback:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(gem list:*)",
      "Bash(circleci config validate:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "// excludedCommands": "Run outside the sandbox from the start, for commands that reliably fail or misdetect inside it. Still auto-mode-classified unless also listed in permissions.allow above, in which case the hard-allow wins.",
    "excludedCommands": [
      "gh *",
      "circleci *",
      "terraform *",
      "git fetch *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/.npm/_cacache"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "/private/tmp/claude/*"
      ],
      "allowLocalBinding": true
    }
  },
  "skipAutoPermissionPrompt": true,
  "showClearContextOnPlanAccept": true,
  "attribution": {
    "sessionUrl": false
  }
}
